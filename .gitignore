.vercel
.env*.local

# Wrangler local secrets for workers/* (e.g. workers/deepen/.dev.vars)
.dev.vars
**/.dev.vars

# Python bytecode (workers/* Python Workers)
__pycache__/
*.pyc

# SQLite content DB (regenerated by `seed:content`; the exported
# data/content/*.json is the committed/shipped artifact)
data/knowledge.db
data/knowledge.db-wal
data/knowledge.db-shm

# SQLite course store (written by seed-topic-courses / scrape:udemy /
# review:courses; exported to data/content/courses.json by export-content)
data/courses.db
data/courses.db-wal
data/courses.db-shm

# Per-chapter DeepSeek caches written by crates/ml/audio-guide.
# Kept off git because they're easy to regenerate from the outline TOML and
# can be many MB; the concatenated `<slug>.script.md` and `<slug>.json` next
# to them ARE tracked so they ship to Vercel.
data/*.chapters/

# Audio binaries served from R2 — too large for Vercel's 100 MB file limit
data/*.mp3
data/*.wav

# Node / Next.js build output
/node_modules/
/.next/
next-env.d.ts
*.tsbuildinfo

# Rust build artifacts — Cargo target dirs (crates/*/target) and the
# generated dependency files cargo emits. Easy to regenerate; never commit.
target/
*.d
