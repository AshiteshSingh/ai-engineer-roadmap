{
  "name": "knowledge",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev -p 3002",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "seed": "tsx --env-file=.env.local scripts/seed.ts",
    "roadmap:meta": "node --import tsx scripts/gen-roadmap-meta.ts",
    "seed:content": "cd crates/ml && cargo run -p knowledge-ml-core --release --bin seed-content",
    "export:content": "cd crates/ml && cargo run -p knowledge-ml-core --release --bin export-content",
    "content:build": "npm run roadmap:meta && npm run seed:content && npm run export:content",
    "content:similarity": "cd crates/ml && cargo run -p knowledge-ml-core --release --bin build-similarity",
    "content:gate:scan": "cd crates/ml && cargo run -q -p knowledge-ml-core --release --bin content-gate -- --all --ai-only",
    "content:gate:check": "cd crates/ml && cargo run -q -p knowledge-ml-core --release --bin content-gate -- --json --slug",
    "content:gate:resolve": "cd crates/ml && cargo run -q -p knowledge-ml-core --release --bin content-gate -- --ai-only --resolve",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:generate": "drizzle-kit generate",
    "backend:dev": "cd backend && uvicorn app:app --host 0.0.0.0 --port 7860 --reload",
    "backend:deploy": "cd backend && wrangler deploy",
    "backend:tail": "cd backend && wrangler tail",
    "test:backend": "cd backend && .venv/bin/pytest -q",
    "test:e2e": "tsx --env-file=.env.local scripts/test-langgraph-e2e.ts",
    "test:e2e:live": "tsx --env-file=.env.local scripts/test-langgraph-e2e.ts --live",
    "test:deepeval": "cd backend && ./run-with-env.sh ../.env.local ../../../.env -- .venv/bin/pytest -q -m 'deepeval and not slow'",
    "test:deepeval:all": "cd backend && ./run-with-env.sh ../.env.local ../../../.env -- .venv/bin/pytest -q -m deepeval",
    "generate": "tsx --env-file=.env.local scripts/generate-article.ts",
    "generate:dry": "tsx --env-file=.env.local scripts/generate-article.ts --dry-run",
    "generate:missing": "tsx --env-file=.env.local scripts/generate-article.ts --list-missing",
    "generate:batch": "tsx --env-file=.env.local scripts/generate-article.ts --batch",
    "generate:graph": "tsx scripts/generate-article.ts --graph",
    "review:courses": "tsx --env-file=.env.local scripts/review-courses.ts",
    "review:courses:dry": "tsx --env-file=.env.local scripts/review-courses.ts --dry-run",
    "scrape:udemy": "tsx --env-file=.env.local scripts/scrape-udemy-courses.ts",
    "email:status": "tsx --env-file=.env.local scripts/email-status.ts",
    "email:status:ensure": "tsx --env-file=.env.local scripts/email-status.ts --ensure-routing",
    "email:test": "tsx --env-file=.env.local scripts/test-send-email.ts",
    "ml:langgraph-audio": "cd crates/ml && cargo run -p langgraph-audio --release --bin build-langgraph-audio"
  },
  "dependencies": {
    "@ai-apps/auth": "workspace:*",
    "@ai-apps/company-intel": "workspace:*",
    "@ai-apps/db-backup": "workspace:*",
    "@ai-apps/deepseek": "workspace:*",
    "@ai-apps/resume": "workspace:*",
    "@apollo/server": "^5.4.0",
    "@as-integrations/next": "^4.1.0",
    "@aws-sdk/client-s3": "^3.1029.0",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@graphql-tools/schema": "^10.0.31",
    "@neondatabase/serverless": "^0.10.4",
    "@posthog/next": "^0.1.0",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/themes": "^3.3.0",
    "@react-pdf/renderer": "^4.3.2",
    "@uiw/react-codemirror": "^4.25.9",
    "@vercel/analytics": "^2.0.1",
    "@xyflow/react": "^12.10.1",
    "drizzle-orm": "^0.45.1",
    "graphql": "^16.13.2",
    "next": "latest",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sucrase": "^3.35.1",
    "unist-util-visit": "^5.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/mdast": "^4.0.4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.9",
    "playwright": "^1.52.0",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "wrangler": "latest"
  }
}
