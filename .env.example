# Copy to .env.local and fill in. NEVER commit real secrets — .env*.local is gitignored.

# --- App / auth ---
PORT=3002
BETTER_AUTH_URL=http://localhost:3002
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3002
BETTER_AUTH_SECRET=
DATABASE_URL=postgresql://USER:PASSWORD@HOST/knowledge?sslmode=require
NEXT_PUBLIC_DATA_SOURCE=neon

# --- Local LLM (article/audio generation) ---
LLM_BASE_URL=http://localhost:8080/v1
LLM_MODEL=mlx-community/Qwen2.5-7B-Instruct-4bit

# --- R2 (audio assets) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=longform-tts
R2_PUBLIC_DOMAIN=tts.vadim.blog

# --- LangGraph backend (knowledge-langgraph on Cloudflare Containers) ---
LANGGRAPH_URL=https://knowledge-langgraph.eeeew.workers.dev
LANGGRAPH_AUTH_TOKEN=
WORKER_URL=https://knowledge-agent.REPLACE.workers.dev
WORKER_AUTH_SECRET=

# --- Cloudflare account ---
CLOUDFLARE_ACCOUNT_ID=

# Cloudflare D1 — audio playback position (knowledge-audio-progress).
# Custom token scope: Account → D1 → Edit.
CLOUDFLARE_AUDIO_D1_ID=
CLOUDFLARE_D1_API_TOKEN=

# --- Email ---
# Inbound Email Routing for ai-engineer-roadmap.xyz (contact@ → Gmail).
# Custom token scope: Account → Email Routing Addresses:Edit;
#                     Zone → Zone:Edit, DNS:Edit, Email Routing Rules:Edit.
CLOUDFLARE_EMAIL_API_TOKEN=

# Outbound Email Sending (Cloudflare Email Service, beta). SEPARATE token —
# the routing token above does NOT carry Sending scope. Mint a token with
# the "Email Sending" permission. Falls back to CLOUDFLARE_EMAIL_API_TOKEN
# if unset (will fail until a Sending-scoped token is provided).
CLOUDFLARE_EMAIL_SENDING_API_TOKEN=

# Domain + addresses used by scripts/email-status.ts and lib/email/cloudflare.ts.
EMAIL_DOMAIN=ai-engineer-roadmap.xyz
EMAIL_FROM=AI Engineer Roadmap <contact@ai-engineer-roadmap.xyz>
EMAIL_ROUTE_DESTINATION=nicolai.vadim@gmail.com
